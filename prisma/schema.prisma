generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  ipProfiles   IPProfile[]
  usageLogs    UsageLog[]
  creditLedger CreditLedger[]

  @@index([username])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model IPProfile {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  founder        String
  personas       String
  personaExtra   String   @default("")
  industry       String
  products       String
  customers      String
  customerExtra  String   @default("")
  goals          String
  goalExtra      String   @default("")
  forbidden      String
  forbiddenExtra String   @default("")
  mixTraffic     Int      @default(4)
  mixPersona     Int      @default(2)
  mixProduct     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topics         Topic[]
  corpusEntries  CorpusEntry[]
  accountMemories AccountMemory[]
  scripts        Script[]

  // 知识库（PRD v2 新增）
  knowledgeContent String?  // AI 结构化知识库内容
  feedScripts      String?  // 投喂的历史脚本（JSON 数组文本）

  @@index([userId])
}

enum CorpusStatus {
  pending
  analyzing
  ready
  confirmed
  rejected
}

model CorpusEntry {
  id         String   @id @default(cuid())
  profileId  String
  profile    IPProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fileName   String
  fileType   String
  fileSize   Int
  fileContent String?

  status     CorpusStatus @default(pending)
  summary    String?
  tags       String?
  aiFeedback String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId])
  @@index([status])
}

enum MemoryCategory {
  fact_correction
  writing_preference
  expression_forbidden
  customer_insight
}

model AccountMemory {
  id        String   @id @default(cuid())
  profileId String
  profile   IPProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  category  MemoryCategory
  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([category])
}

model Topic {
  id           String   @id @default(cuid())
  profileId    String
  profile      IPProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type         String
  title        String
  description  String
  script       String?
  publishCopy  String?
  shootingTips String?
  weekKey      String
  createdAt    DateTime @default(now())

  @@index([profileId])
  @@index([weekKey])
}

model UsageLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  creditsUsed Int      @default(1)
  profileId   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// 脚本表（PRD v2 新增）— 每条选题可生成 3 个差异化版本
model Script {
  id                 String   @id @default(cuid())
  profileId          String
  profile            IPProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topicId            String?  // 关联选题（可选，允许独立生成）

  content            String   // 脚本正文
  version            Int      @default(1)  // 版本号 1/2/3
  isSavedToKnowledge Boolean  @default(false)  // 是否已入库知识库

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([profileId])
  @@index([topicId])
  @@index([version])
}
