// 创世者 Copilot - 核心共享 Schema（public）
// 包含：用户、Session、积分、审计日志等跨产品共享表

generator client {
  provider = "prisma-client-js"
  output   = "./client-core"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  password  String
  name      String?
  role      String   @default("user")
  points    Int      @default(110)
  products  String[] @default([]) // 授权产品列表: ['ip-copilot', 'edu-box']
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  generationLogs  GenerationLog[]
  pointsRecharges PointsRecharge[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model GenerationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  model     String?
  status    String
  tokens    Int      @default(0)
  duration  Int      @default(0)
  cost      Float    @default(0)
  error     String?
  product   String   @default("ip-copilot") // 区分产品来源
  createdAt DateTime @default(now())
}

model PointsRecharge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  points    Int
  bonus     Int      @default(0)
  status    String   @default("pending")
  payMethod String   @default("wechat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
