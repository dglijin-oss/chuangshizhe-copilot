// 创世者 Copilot - 启明盒子教育业务 Schema（edu Schema）
// 初始为空模板，后续添加教育相关模型

generator client {
  provider        = "prisma-client-js"
  output          = "./client-edu"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["edu"]
}

