{
  "name": "@chuangshizhe/database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate:all": "pnpm db:generate:core && pnpm db:generate:ip",
    "db:generate:core": "prisma generate --schema=./schema-core.prisma",
    "db:generate:ip": "prisma generate --schema=./schema-ip.prisma",
    "db:push:all": "pnpm db:push:core && pnpm db:push:ip",
    "db:push:core": "prisma db push --schema=./schema-core.prisma",
    "db:push:ip": "prisma db push --schema=./schema-ip.prisma"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
