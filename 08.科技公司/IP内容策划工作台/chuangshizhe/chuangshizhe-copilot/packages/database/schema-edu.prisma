// 创世者 Copilot - 启明盒子教育业务 Schema（edu Schema）
// 覆盖两大模块：
//   1. AI 协同平台（教师、学生、班级、教案、作业、学情、AI 对话）
//   2. 研学项目管理（产品、报名、供应商、安全文档、财务结算）

generator client {
  provider        = "prisma-client-js"
  output          = "./client-edu"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "edu"]
}

// ============================================================
// 一、组织与人员
// ============================================================

/// 学校
model EduSchool {
  id        String   @id @default(cuid())
  name      String
  type      String   // 小学 / 初中 / 高中 / 九年一贯制 / 完全中学
  region    String?  // 所在地区
  address   String?
  contact   String?  // 联系人
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teachers    EduTeacher[]
  classes     EduClass[]
  tours       StudyTourProduct[]
  bookings    StudyTourBooking[]
  settlements StudyTourSettlement[]

  @@schema("edu")
}

/// 教师（关联 User 表，共享登录）
model EduTeacher {
  id       String  @id @default(cuid())
  userId   String? // 关联 public.User，nullable 表示尚未注册用户
  schoolId String
  school   EduSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  subjects String[]  // 任教科目
  role     String   @default("teacher") // teacher / admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonPlans   EduLessonPlan[]
  dialogues     EduDialogue[]
  homeworks     EduHomework[]
  aiGenerations EduAIGeneration[]

  @@schema("edu")
}

/// 班级
model EduClass {
  id          String   @id @default(cuid())
  schoolId    String
  school      EduSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String    // 如 "2024级3班"
  grade       String    // 年级：一年级 ~ 高三
  teacherId   String?   // 班主任
  studentCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students  EduStudent[]
  homeworks EduHomework[]

  @@schema("edu")
}

/// 学生
model EduStudent {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  class       EduClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String
  gender      String?   // 男 / 女
  birthDate   DateTime?
  parentName  String?
  parentPhone String?
  healthNote  String?   // 健康备注（过敏史、既往病史等）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profiles      EduStudentProfile[]
  submissions   EduHomeworkSubmission[]
  tourBookings  StudyTourBooking[]

  @@schema("edu")
}

// ============================================================
// 二、AI 协同平台
// ============================================================

/// AI 教案
model EduLessonPlan {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     EduTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  subject     String
  grade       String
  unit        String?   // 章节/单元
  objectives  Json?     // 教学目标（三维目标）
  content     Json      // 完整教案内容（教学重难点、过程、板书设计等）
  agent       String   @default("jiangxin") // 使用的智能体：匠心
  tokensUsed  Int      @default(0)
  status      String   @default("draft") // draft / published / archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
  @@schema("edu")
}

/// 作业/测评
model EduHomework {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    EduTeacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId    String
  class      EduClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  subject    String
  type       String   @default("normal") // normal / tiered / extension
  content    Json      // 作业内容（题目、分层要求等）
  dueDate    DateTime?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  submissions EduHomeworkSubmission[]

  @@index([classId])
  @@index([teacherId])
  @@schema("edu")
}

/// 作业提交
model EduHomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  homework    EduHomework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     EduStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     Json?     // 提交内容（文字/图片/文件）
  score       Float?
  aiAnalysis  String?   // AI 初评意见
  teacherNote String?   // 教师最终评语
  submittedAt DateTime @default(now())

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@schema("edu")
}

/// AI 对话记录
model EduDialogue {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    EduTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  agent      String   // 智能体标识：jiangxin / wenqu / mingjian / mingxin / lexue / renfu / zhiyuan / shanzhi
  topic      String?  // 对话主题
  messages   Json     // 完整对话历史 [{role, content, timestamp}]
  tokensUsed Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([teacherId])
  @@index([agent])
  @@schema("edu")
}

/// AI 生成记录（通用，覆盖所有 AI 产出：教案、作业、评语、学情分析等）
model EduAIGeneration {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    EduTeacher @relation(fields: [teacherId], references: [id])
  type       String   // lesson_plan / homework / comment / analysis / notification
  agent      String
  prompt     String?
  result     Json?    // AI 生成结果
  tokensUsed Int      @default(0)
  cost       Float    @default(0)
  status     String   @default("success") // success / failed
  error      String?
  createdAt  DateTime @default(now())

  @@index([teacherId])
  @@index([type])
  @@schema("edu")
}

/// 学生学情/心理档案
model EduStudentProfile {
  id               String   @id @default(cuid())
  studentId        String
  student          EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicLevel    String?   // 学业水平：优 / 良 / 中 / 待提高
  psychologicalNote String?  // 心理分析备注
  behaviorNote     String?   // 行为表现
  strengths        String[]  // 优势/特长
  weaknesses       String[]  // 薄弱点
  lastAssessmentAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([studentId])
  @@schema("edu")
}

// ============================================================
// 三、研学项目管理
// ============================================================

/// 研学产品/线路
model StudyTourProduct {
  id             String   @id @default(cuid())
  schoolId       String?  // 关联学校（null 表示通用产品）
  school         EduSchool? @relation(fields: [schoolId], references: [id])
  name           String
  type           String   // 乡村 / 城市 / 营地 / 定制
  grade          String   // 适用年级
  duration       Int      // 天数
  description    String?
  itinerary      Json?    // 行程安排
  costBreakdown  Json?    // 成本明细
  pricePerStudent Float   @default(0)
  minStudents    Int      @default(30) // 最低成团人数
  status         String   @default("draft") // draft / published / active / completed / cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings     StudyTourBooking[]
  suppliers    StudyTourSupplierProduct[]
  safetyDocs   StudyTourSafetyDoc[]
  settlements  StudyTourSettlement[]
  feedbacks    StudyTourFeedback[]

  @@schema("edu")
}

/// 研学报名
model StudyTourBooking {
  id          String    @id @default(cuid())
  productId   String
  product     StudyTourProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  schoolId    String
  school      EduSchool  @relation(fields: [schoolId], references: [id])
  studentId   String?   // 关联本校学生，nullable 表示非本校报名
  student     EduStudent? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName String
  parentName  String
  parentPhone String
  healthNote  String?   // 家长填写的健康备注
  status      String    @default("pending") // pending / confirmed / cancelled
  paymentStatus String  @default("unpaid") // unpaid / paid / refunded
  price       Float     @default(0) // 实际收费
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
  @@index([schoolId])
  @@index([status])
  @@schema("edu")
}

/// 供应商
model StudyTourSupplier {
  id          String   @id @default(cuid())
  name        String
  category    String   // 交通 / 餐饮 / 住宿 / 场地 / 医疗 / 其他
  contact     String?
  phone       String?
  licenseNo   String?  // 营业执照号
  address     String?
  rating      Float    @default(0)   // 综合评分 0-5
  grade       String   @default("C") // A / B / C / D
  safetyScore Int      @default(0)   // 安全评分 0-100
  serviceScore Int     @default(0)   // 服务评分
  priceScore  Int      @default(0)   // 价格评分
  responseScore Int    @default(0)   // 响应速度评分
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products StudyTourSupplierProduct[]

  @@schema("edu")
}

/// 产品-供应商关联（记录某产品使用的供应商及评分）
model StudyTourSupplierProduct {
  id          String   @id @default(cuid())
  productId   String
  product     StudyTourProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    StudyTourSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  role        String   // 在该产品中的角色：承运 / 用餐 / 住宿 / 场地
  cost        Float    @default(0)
  rating      Float?   // 本次服务评分
  note        String?
  createdAt   DateTime @default(now())

  @@unique([productId, supplierId, role])
  @@schema("edu")
}

/// 安全文档
model StudyTourSafetyDoc {
  id        String   @id @default(cuid())
  productId String
  product   StudyTourProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   // 安全责任书 / 服务协议 / 致家长信 / 安全应急预案 / 活动方案 / 营业执照
  title     String
  content   String?  // 文档内容/文本
  fileUrl   String?  // 附件地址
  status    String   @default("draft") // draft / approved / archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([type])
  @@schema("edu")
}

/// 财务结算
model StudyTourSettlement {
  id              String   @id @default(cuid())
  productId       String
  product         StudyTourProduct @relation(fields: [productId], references: [id])
  schoolId        String
  school          EduSchool  @relation(fields: [schoolId], references: [id])
  totalRevenue    Float    @default(0) // 总收入
  totalCost       Float    @default(0) // 总成本
  profit          Float    @default(0) // 利润
  studentCount    Int      @default(0) // 参与人数
  costBreakdown   Json?    // 成本明细（交通、餐饮、住宿、门票、导师、保险等）
  status          String   @default("pending") // pending / settled / closed
  settledAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@schema("edu")
}

/// 研学反馈
model StudyTourFeedback {
  id        String   @id @default(cuid())
  productId String
  product   StudyTourProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  role      String   // 学生 / 家长 / 学校
  name      String?
  rating    Int      // 满意度 1-5
  content   String?
  suggestions String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([rating])
  @@schema("edu")
}
