generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AccountMemory {
  id        String   @id
  userId    String
  ipId      String?
  category  String
  content   String
  confirmed Boolean  @default(true)
  createdAt DateTime @default(now())
  Ip        Ip?      @relation(fields: [ipId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@index([ipId])
  @@index([userId])
}

model CompileEvent {
  id        String   @id
  userId    String
  action    String
  detail    String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model CorpusFeed {
  id         String   @id
  userId     String
  ipId       String?
  feedType   String
  title      String?
  fileName   String?
  content    String?
  status     String   @default("pending")
  suggestion String?
  createdAt  DateTime @default(now())
  Ip         Ip?      @relation(fields: [ipId], references: [id])
  User       User     @relation(fields: [userId], references: [id])

  @@index([ipId])
  @@index([userId])
}

model GenerationLog {
  id        String   @id
  userId    String
  type      String
  model     String?
  status    String
  tokens    Int      @default(0)
  duration  Int      @default(0)
  cost      Float    @default(0)
  error     String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model GenerationRule {
  id              String   @id
  userId          String
  name            String
  articleType     String   @default("promo")
  tone            String   @default("professional")
  targetLength    Int      @default(1200)
  targetQuestions String?
  extraRules      String?
  createdAt       DateTime @default(now())
  User            User     @relation(fields: [userId], references: [id])
}

model GeoArticle {
  id              String          @id
  userId          String
  ipId            String?
  topic           String
  keywords        String?
  platform        String?
  tone            String          @default("professional")
  targetLength    Int             @default(1200)
  targetQuestions String?
  articleType     String          @default("promo")
  content         String?
  status          String          @default("draft")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  Ip              Ip?             @relation(fields: [ipId], references: [id])
  User            User            @relation(fields: [userId], references: [id])
  PublishRecord   PublishRecord[]
}

model IntegrationConfig {
  id         String   @id
  userId     String
  platform   String
  configName String
  configData String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id])
}

model Ip {
  id                String            @id
  userId            String
  name              String
  founderName       String?
  founderTraits     String?
  industry          String?
  products          String?
  targetClients     String?
  accountGoals      String?
  contentBan        String?
  contentMixFlow    Int               @default(4)
  contentMixPersona Int               @default(2)
  contentMixProduct Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  AccountMemory     AccountMemory[]
  CorpusFeed        CorpusFeed[]
  GeoArticle        GeoArticle[]
  User              User              @relation(fields: [userId], references: [id])
  KnowledgeBase     KnowledgeBase?
  KnowledgeSource   KnowledgeSource[]
  WeeklyPlan        WeeklyPlan[]
  WikiPage          WikiPage[]
}

model Keyword {
  id           String        @id
  userId       String
  groupId      String?
  content      String
  isHot        Boolean       @default(false)
  createdAt    DateTime      @default(now())
  KeywordGroup KeywordGroup? @relation(fields: [groupId], references: [id])
  User         User          @relation(fields: [userId], references: [id])
}

model KeywordGroup {
  id        String    @id
  userId    String
  name      String
  createdAt DateTime  @default(now())
  Keyword   Keyword[]
  User      User      @relation(fields: [userId], references: [id])
}

model KnowledgeBase {
  id         String   @id
  userId     String
  ipId       String?  @unique
  content    String
  sourceType String   @default("wiki")
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Ip         Ip?      @relation(fields: [ipId], references: [id])
  User       User     @relation(fields: [userId], references: [id])
}

model KnowledgeSource {
  id         String     @id
  userId     String
  ipId       String?
  sourceType String
  title      String
  subtitle   String?
  content    String?
  fileName   String?
  status     String     @default("active")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  Ip         Ip?        @relation(fields: [ipId], references: [id])
  User       User       @relation(fields: [userId], references: [id])
  WikiPage   WikiPage[]
}

model PointsRecharge {
  id        String   @id
  userId    String
  amount    Float
  points    Int
  bonus     Int      @default(0)
  status    String   @default("pending")
  payMethod String   @default("wechat")
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model PublishRecord {
  id            String      @id
  userId        String
  geoArticleId  String?
  platform      String
  title         String
  content       String?
  url           String?
  status        String      @default("pending")
  publishedAt   DateTime?
  views         Int         @default(0)
  aiQuotes      Int         @default(0)
  consultations Int         @default(0)
  createdAt     DateTime    @default(now())
  GeoArticle    GeoArticle? @relation(fields: [geoArticleId], references: [id])
  User          User        @relation(fields: [userId], references: [id])
}

model Questionnaire {
  id              String   @id
  userId          String
  industry        String?
  businessVolume  String?
  role            String?
  teamSize        String?
  clientLocation  String?
  primaryPlatform String?
  contentFreq     String?
  accountGoal     String?
  contentPain     String?
  clientType      String?
  priceRange      String?
  salesCycle      String?
  aiUsageFreq     String?
  productIntro    String?
  supplement      String?
  submitted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  User            User     @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model User {
  id                String              @id
  phone             String              @unique
  password          String
  name              String?
  role              String              @default("user")
  points            Int                 @default(110)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  AccountMemory     AccountMemory[]
  CompileEvent      CompileEvent[]
  CorpusFeed        CorpusFeed[]
  GenerationLog     GenerationLog[]
  GenerationRule    GenerationRule[]
  GeoArticle        GeoArticle[]
  IntegrationConfig IntegrationConfig[]
  Ip                Ip[]
  Keyword           Keyword[]
  KeywordGroup      KeywordGroup[]
  KnowledgeBase     KnowledgeBase[]
  KnowledgeSource   KnowledgeSource[]
  PointsRecharge    PointsRecharge[]
  PublishRecord     PublishRecord[]
  Questionnaire     Questionnaire[]
  Session           Session[]
  WeeklyPlan        WeeklyPlan[]
  WikiPage          WikiPage[]
}

model WeeklyPlan {
  id             String           @id
  userId         String
  ipId           String?
  weekStart      DateTime
  weekEnd        DateTime
  content        String?
  articleCount   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  userDirection  String?
  Ip             Ip?              @relation(fields: [ipId], references: [id])
  User           User             @relation(fields: [userId], references: [id])
  WeeklyPlanItem WeeklyPlanItem[]
}

model WeeklyPlanItem {
  id               String     @id
  planId           String
  contentType      String
  title            String
  reason           String
  generationStatus String     @default("idle")
  createdAt        DateTime   @default(now())
  generatedResult  Json?
  WeeklyPlan       WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model WikiPage {
  id              String           @id
  userId          String
  title           String
  category        String
  content         String
  sourceId        String?
  ipId            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  Ip              Ip?              @relation(fields: [ipId], references: [id])
  KnowledgeSource KnowledgeSource? @relation(fields: [sourceId], references: [id])
  User            User             @relation(fields: [userId], references: [id])
}
